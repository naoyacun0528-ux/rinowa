<!--
  The themed-icon layer.

  Same three arcs, but at one weight. The launcher foreground grades its arcs by opacity;
  a themed icon is re-tinted a single colour by the system and that grading would come back
  as three different greys, which reads as a rendering fault rather than a design.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M44.5,43.4 Q33.8,54 44.5,64.6"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <path
        android:pathData="M59.3,33.8 Q44.5,54 59.3,74.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <path
        android:pathData="M74.2,27.1 Q55.1,54 74.2,80.9"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

</vector>
