<!--
  Handset, tilted to answer. Same path as ic_call_end, rotated -135 degrees —
  which is the relationship Material itself uses between call and call_end.
  Drawing it as one shape in two positions keeps the pair readable: the same
  object, picked up or put down.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-135">
        <path
            android:pathData="M2.5,14.5 C7,10 17,10 21.5,14.5 L19.5,17 L16,15.2 L16,12.6 C13.4,11.8 10.6,11.8 8,12.6 L8,15.2 L4.5,17 z"
            android:fillColor="#FFFFFF" />
    </group>
</vector>
